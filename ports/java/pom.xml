<?xml version="1.0" encoding="UTF-8"?>
<!-- SmartSwitch agent for Java. Not published to any Maven repository; build from this folder:
     mvn -q compile && java -cp target/classes cloud.smarttasks.smartswitch.Conformance ../../spec/conformance
     (or ./build.sh without Maven). No dependencies. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cloud.smarttasks</groupId>
  <artifactId>sf-smartswitch</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>SmartSwitch (Java port, agent side)</name>
  <licenses><license><name>Apache-2.0</name></license></licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>

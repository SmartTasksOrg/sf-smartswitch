# Copy to deploy/.env and fill in. deploy/.env is ignored by git; never commit real values.
# Generate tokens with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SMARTSWITCH_AGENT_TOKEN=
SMARTSWITCH_OPERATOR_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# Optional
SMARTSWITCH_OPERATOR_ALLOW=
SMARTSWITCH_ALERT_WEBHOOK=

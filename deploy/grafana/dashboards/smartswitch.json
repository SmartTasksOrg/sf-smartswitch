     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum(rate(smartswitch_aggregation_ms_bucket[15m])) by (le))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "id": 5
  },

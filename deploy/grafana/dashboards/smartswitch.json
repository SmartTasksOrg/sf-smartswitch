  {
   "type": "stat",
   "title": "Fleet halted",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "smartswitch_halted",
     "legendFormat": "halted"
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Agents halted one by one",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
